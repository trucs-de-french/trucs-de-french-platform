# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 (S3-compatible API, used only server-side to sign uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 buckets + their public custom domains (task "use custom R2 domains
# for media, images and games"). media./images./games.trucsdefrench.com
# are the current defaults — the legacy pub-<hex>.r2.dev hosts are still
# accepted by the code (src/lib/validate-r2-url.ts, src/lib/script-import/
# import-from-video-subtitles.ts) for old content already in the database,
# but new uploads should always use these custom domains.
R2_BUCKET_NAME=task-audio
R2_PUBLIC_URL=https://media.trucsdefrench.com
R2_IMAGES_BUCKET_NAME=task-images
R2_IMAGES_PUBLIC_URL=https://images.trucsdefrench.com
R2_HTML_GAMES_BUCKET_NAME=task-html-games
R2_HTML_GAMES_PUBLIC_URL=https://games.trucsdefrench.com

# AI features
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
